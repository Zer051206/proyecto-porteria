# --- ETAPA 1: BUILD (Compilar la aplicación) ---
FROM node:20-alpine AS builder

WORKDIR /app

# Copia e instala las dependencias de producción y desarrollo
COPY package*.json ./
RUN npm install

# Copia el código fuente del frontend
COPY . .

# Compila la aplicación (ajusta 'build' si usas otro comando, como 'npm run vite:build')
RUN npm run build

# --- ETAPA 2: RUN (Servir la aplicación compilada) ---
# Usamos Nginx, un servidor web súper ligero y rápido, para servir el contenido estático
FROM nginx:alpine

# Copiamos la configuración de Nginx (esto es clave para el enrutamiento del frontend)
# Crea un archivo 'nginx.conf' en 'client/' si necesitas configuración específica.
# Si no lo tienes, Nginx usará una configuración por defecto.
# COPY ./nginx.conf /etc/nginx/conf.d/default.conf

# Copiamos los archivos estáticos generados desde la etapa 'builder'
COPY --from=builder /app/dist /usr/share/nginx/html

# Puerto por defecto de Nginx
EXPOSE 80

# El comando por defecto de Nginx arranca el servidor
CMD ["nginx", "-g", "daemon off;"]